#!/usr/bin/env python3
"""xref_maestro.py — resolve PC-relative references to a byte offset in a kext.

Three defects in this tool are worth recording, because each one produced a
clean, confident, and wrong answer of exactly the kind this project has been
burned by repeatedly:

1. VA from file offset. `va = vmaddr + fileoff` is wrong; it must be
   `vmaddr + (fileoff - fileoff_of_segment)`. Getting this wrong yields zero
   hits, and zero hits reads as "this string is never referenced" rather than
   "I computed the address wrong".

2. Scanning __TEXT only. In this collection the code lives in __TEXT_EXEC
   (13,474 BL / 13,666 ADRP / 1,063 RET) while __TEXT is mostly constants
   (3 BL). Scanning __TEXT alone finds nothing.

3. ADRP's PC is the instruction's *VA*, not its file offset. These differ by
   2.5 GB here (__TEXT_EXEC is at 0xfffffff009bd1ab0). Using the file offset
   makes every computed target page land in the 0x-d7f.. region and the whole
   histogram becomes nonsense — the signature of this bug is a histogram of
   absurd addresses, not of zero hits.

So the scan is per-segment, and for each candidate instruction the PC used is
the segment's own vmaddr plus the in-segment offset. BL/B are also VA-based and
are printed relative to the segment so the output stays readable as file
offsets.
"""
import struct
import sys


def load(path):
    d = open(path, "rb").read()
    ncmds = struct.unpack_from("<I", d, 16)[0]
    off = 32
    segs = []
    for _ in range(ncmds):
        cmd, cs = struct.unpack_from("<II", d, off)
        if cmd == 0x19:
            name = d[off + 8:off + 24].rstrip(b"\x00").decode(errors="replace")
            va, vs, fo, fs = struct.unpack_from("<QQQQ", d, off + 24)
            segs.append((name, va, vs, fo, fs))
        if cs == 0:
            break
        off += cs
    return d, segs


def sx(v, bits):
    m = 1 << (bits - 1)
    return (v ^ m) - m


def decode(d, off):
    w = struct.unpack_from("<I", d, off)[0]
    if (w & 0x7C000000) == 0x14000000:
        imm = sx(w & 0x03FFFFFF, 26) << 2
        return ("bl" if (w & 0x80000000) == 0 else "b"), imm
    if (w & 0xFF000010) == 0x54000000:
        return "b.cond", sx((w >> 5) & 0x7FFFF, 19) << 2
    if (w & 0x7E000000) == 0x34000000:
        return ("cbz" if (w & 0x01000000) == 0 else "cbnz"), \
               sx((w >> 5) & 0x7FFFF, 19) << 2
    if (w & 0x7E000000) == 0x36000000:
        return ("tbz" if (w & 0x01000000) == 0 else "tbnz"), \
               sx((w >> 19 & 0x3FFFF), 19) << 2
    if (w & 0x9F000000) == 0x90000000:
        return "adrp", None
    if (w & 0x7F800000) == 0x12800000:
        return ["movn", "movz", "movk", "movz"][(w >> 29) & 3], \
            ((w >> 5) & 0xFFFF) << (((w >> 21) & 1) * 16)
    if (w & 0x7F800000) == 0x11000000:
        return ("sub" if (w >> 30) & 1 else "add"), (w >> 10) & 0xFFF
    if (w & 0x7F800000) == 0x71000000:
        return ("cmp" if (w >> 30) & 1 else "cmn"), (w >> 10) & 0xFFF
    if (w & 0x7FE0FFE0) == 0x2A0003E0:
        return "mov", None
    if (w & 0x7F200000) == 0x0B000000:
        return ("sub" if (w >> 30) & 1 else "add"), None
    if (w & 0x3F000000) == 0x39000000:
        return ("ldr" if (w >> 22) & 1 else "str"), \
            (((w >> 10) & 0xFFF) << (w >> 30))
    if (w & 0x3B000000) == 0x39000000 and (w & 0x03800000) == 0x01800000:
        return "ldrsw", ((w >> 10) & 0xFFF) << 2
    if (w & 0x3F000000) == 0x18000000:
        return "ldr-lit", sx((w >> 5) & 0x7FFFF, 19) << 2
    if (w & 0xFFFFFC1F) == 0xD65F0000:
        return "ret", None
    if (w & 0x7F800000) == 0x1B000000 and ((w >> 10) & 31) == 31:
        return "mul", None
    if (w & 0x7F800000) == 0x1B000000:
        return "madd", None
    return "?", None


def main():
    path = sys.argv[1]
    targets = [int(x, 0) for x in sys.argv[2].split(",")]
    win = int(sys.argv[3]) if len(sys.argv) > 3 else 32
    d, segs = load(path)
    text = [s for s in segs if s[0] == "__TEXT"][0]
    base, tro = text[1], text[3]

    for nm, va, vs, fo, fs in segs:
        print("   %-14s va=%#-16x fo=%#-10x filesize=%#x" % (nm, va, fo, fs))

    want = {}
    for t in targets:
        want[t] = base + (t - tro)
    pages = {}
    for t, va in want.items():
        pages.setdefault(va & ~0xFFF, set()).add(va)

    hits = []
    for nm, va, vs, fo, fs in segs:
        if nm == "__LINKEDIT" or not fs:
            continue
        end = min(len(d), fo + fs)
        for off in range(fo, end - 3, 4):
            w = struct.unpack_from("<I", d, off)[0]
            if (w & 0x9F000000) != 0x90000000:
                continue
            pc = va + (off - fo)                     # VA of this instruction
            imm = sx((((w >> 5) & 0x7FFFF) << 2) | ((w >> 29) & 3), 21) << 12
            page = (pc & ~0xFFF) + imm
            if page not in pages:
                continue
            rd = w & 31
            for k in range(1, 7):
                p2 = off + 4 * k
                if p2 + 4 > len(d):
                    break
                w2 = struct.unpack_from("<I", d, p2)[0]
                # ADD/SUB immediate with same source register
                if (w2 & 0x7F800000) == 0x11000000 and ((w2 >> 5) & 31) == rd:
                    cand = page + ((w2 >> 10) & 0xFFF)
                    for t, tva in want.items():
                        if cand == tva:
                            hits.append((off, p2, t))
                # LDR unsigned imm with same base
                if (w2 & 0x3F000000) == 0x39000000 and ((w2 >> 5) & 31) == rd:
                    cand = page + (((w2 >> 10) & 0xFFF) << (w2 >> 30))
                    for t, tva in want.items():
                        if cand == tva:
                            hits.append((off, p2, t))
                # ADD/SUB shifted register with same source register
                if (w2 & 0x7F200000) == 0x0B000000 and ((w2 >> 5) & 31) == rd:
                    cand = page + ((w2 >> 16) & 31) << ((w2 >> 22) & 3)
                    for t, tva in want.items():
                        if cand == tva:
                            hits.append((off, p2, t))

    uniq = []
    for h in hits:
        if h not in uniq:
            uniq.append(h)
    print("\n%d reference sites to %s" % (len(uniq), ", ".join(hex(t) for t in targets)))
    for off, p2, t in uniq:
        seg = [s for s in segs if s[3] <= off < s[3] + s[4]][0]
        s = max(seg[3], off - win * 4)
        e = min(seg[3] + seg[4], off + win * 4)
        print("\n=== string file 0x%06x (VA %#x) referenced at 0x%06x ==="
              % (t, want[t], off))
        o = s
        while o < e:
            nm, arg = decode(d, o)
            txt = nm if arg is None else "%s %s" % (nm, ("0x%x" % arg) if arg >= 0 else str(arg))
            if nm in ("bl", "b", "b.cond", "cbz", "cbnz", "tbz", "tbnz") and arg:
                tgt_va = seg[1] + (o - seg[3]) + arg
                txt += "        ; -> file 0x%x" % (seg[3] + (tgt_va - seg[1]))
            print("  %s 0x%06x  %s" % (">>" if o == off else ("**" if o == p2 else "  "), o, txt))
            o += 4


if __name__ == "__main__":
    main()
