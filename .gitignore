# v166: the restore image itself (23 GB) and the ROM/payload dumps it yields.
# Everything here is re-derivable: scripts/securerom/extract.sh + the IPSW from
# Apple's CDN. Committing 23 GB of firmware buys nothing a reader cannot get.
ipsw/
results/securerom/ipsw/*.im4p
results/securerom/ipsw/*.im4m
results/securerom/ipsw/*.bin
results/securerom/ipsw/*.aea
results/securerom/ipsw/kernelcache.*
# the two decrypted ROM dumps: 1 MB total, kept out so the repo holds only
# derived results. Put them in dumps/ to regenerate an audit from scratch.
dumps/*ROM*
# focused findings extracted from the ROMs are small and DO belong in git
!results/securerom/findings/

# v168: per-kext string extraction is regenerated by
# results/securerom/kext_strings.py from the kernelcache in seconds. The carved
# blobs are 265 files totalling over 2 GB and are worthless in git; the derived
# TSV they produce is committed instead.
results/kc27/all/
results/kc27/audit/
results/liveentity/
# v184: carve-бинари PPRP-клиентов (6 штук, ~3.2 МБ) — вырезаются фазой
# p_pprp заново за один прогон; в git идёт только скрипт wrap_flat.py.
results/pprp/carve-*.bin

# v195: dyld-кэш устройства — сабфайлы .01/.30 для строкового RE
# wire-формата BS-домена (§202/§203). Копируются заново фазой bq44
# с FUZZ_BQ44_ONLY=<имя>; на хост не коммитятся (262 МБ).
results/dycache/
